[
  {
    "name": "App shell JS (entry + runtime + React)",
    "path": [
      "dist/assets/index-*.js",
      "dist/assets/rolldown-runtime-*.js",
      "dist/assets/vendor-framework-*.js"
    ],
    "limit": "63 KB"
  },
  {
    "name": "Router",
    "path": "dist/assets/vendor-router-*.js",
    "limit": "36 KB"
  },
  {
    "name": "All CSS",
    "path": "dist/assets/*.css",
    "limit": "84 KB"
  },
  {
    "name": "All JS",
    "path": "dist/assets/*.js",
    "limit": "5550 KB"
  },
  {
    "name": "Lazy: Task explanations",
    "path": "dist/assets/task-explanations-*.js",
    "limit": "240 KB"
  },
  {
    "name": "Lazy: Three.js",
    "path": "dist/assets/vendor-three-*.js",
    "limit": "120 KB"
  },
  {
    "name": "Lazy: Prettier",
    "path": "dist/assets/vendor-prettier-*.js",
    "limit": "420 KB"
  },
  {
    "name": "Lazy: Sucrase",
    "path": "dist/assets/vendor-compiler-*.js",
    "limit": "40 KB"
  },
  {
    "name": "Lazy: xterm",
    "path": "dist/assets/vendor-xterm-*.js",
    "limit": "72 KB"
  },
  {
    "name": "Lazy: React Flow",
    "path": "dist/assets/BoardViewControls-*.js",
    "limit": "55 KB"
  },
  {
    "name": "Lazy: Markdown",
    "path": "dist/assets/vendor-markdown-*.js",
    "limit": "25 KB"
  },
  {
    "name": "Lazy: Mermaid (entry, flowchart, sequence, gantt, dagre)",
    "path": [
      "dist/assets/renderMermaid-*.js",
      "dist/assets/flowDiagram-*.js",
      "dist/assets/sequenceDiagram-*.js",
      "dist/assets/ganttDiagram-*.js",
      "dist/assets/dagre-*.js"
    ],
    "limit": "95 KB"
  }
]
