{
  "name": "Code-Practice-Platform",
  "private": true,
  "version": "2.4.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"e2e/**/*.ts\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"e2e/**/*.ts\" \"*.{ts,js,json}\"",
    "generate:editor-tags": "node scripts/generate-editor-tags.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "emmet": "^2.4.11",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "sucrase": "^3.35.1",
    "three": "^0.186.1",
    "vscode-html-languageservice": "^5.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@conarti/eslint-plugin-feature-sliced": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^13.1.1",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/utils": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.1",
    "size-limit": "^13.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
